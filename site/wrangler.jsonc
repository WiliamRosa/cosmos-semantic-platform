// Cloudflare Worker for cosmosdata.ai: static assets from site/dist, the www redirect and the contact form
// endpoint (POST /api/contact) in worker/index.js, which mails messages through Email Routing.
{
  "name": "cosmos-semantic-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "cosmosdata.ai", "custom_domain": true },
    { "pattern": "www.cosmosdata.ai", "custom_domain": true }
  ],
  // Email Routing must be enabled on cosmosdata.ai. Cloudflare only delivers to a verified
  // destination address of Email Routing, so the recipient is not kept here: the site workflow
  // passes it from the CONTACT_TO repository secret (see site/README.md).
  // run_worker_first lets the Worker redirect www to the apex for every path.
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "vars": {
    "CONTACT_FROM": "website@cosmosdata.ai"
  },
  "observability": { "enabled": true }
}
